  ORLS_DEPT_ID Int

  @@map("___XTR_ORDER_LINE_STATUS")
}

model XTR_ORDER_STATUS {
  ORDS_ID      Int    @id @default(autoincrement())
  ORDS_NAMED   String @db.VarChar(255)
  ORDS_ACTION  String @db.VarChar(255)
  ORDS_COLOR   String @default("f7f8f9") @db.VarChar(6)
  ORDS_DEPT_ID Int

  @@map("___XTR_ORDER_STATUS")
}

model XTR_SUPPLIER {
  SPL_ID      Int     @id @default(autoincrement()) @db.UnsignedSmallInt
  SPL_NAME    String  @db.VarChar(255)
  SPL_ALIAS   String  @unique(map: "SPL_ALIAS_2") @db.VarChar(255)
  SPL_DISPLAY Boolean
  SPL_SORT    Int     @db.SmallInt

  @@index([SPL_ALIAS], map: "SPL_ALIAS")
  @@index([SPL_ID], map: "SPL_ID")
  @@index([SPL_SORT], map: "SPL_SORT")
  @@map("___XTR_SUPPLIER")
}

model XTR_SUPPLIER_LINK_PM {
  SLPM_ID      Int     @id @default(autoincrement()) @db.UnsignedInt
  SLPM_PM_ID   Int     @db.UnsignedSmallInt
  SLPM_SPL_ID  Int     @db.UnsignedSmallInt
  SLPM_DISPLAY Boolean @default(false)

  @@index([SLPM_DISPLAY], map: "SLPM_DISPLAY")
  @@index([SLPM_PM_ID], map: "SLPM_PM_ID")
  @@index([SLPM_SPL_ID], map: "SLPM_SPL_ID")
  @@map("___XTR_SUPPLIER_LINK_PM")
}

model ic_postback {
  ID_IC_POSTBACK Int       @id @default(autoincrement()) @db.UnsignedInt
  id_com         String?   @db.VarChar(25)
  Status         String?   @db.VarChar(25)
  StatusCode     String?   @db.VarChar(25)
  idsite         Int?      @db.TinyInt
  idste          Int       @db.TinyInt
  OrderID        String?   @db.VarChar(25)
  PaymentID      String?   @db.VarChar(25)
  TransactionID  String?   @db.VarChar(25)
  Amount         String?   @db.VarChar(25)
  Currency       String?   @db.VarChar(25)
  PaymentMethod  String?   @db.VarChar(25)
  Ip             String    @db.VarChar(25)
  Ips            String    @db.VarChar(25)
  DatePayment    DateTime? @db.DateTime(0)

  @@index([DatePayment], map: "DatePayment")
  @@index([OrderID], map: "OrderID")
  @@index([PaymentID], map: "PaymentID")
  @@index([PaymentMethod], map: "PaymentMethod")
  @@index([Status], map: "Status")
  @@index([id_com], map: "id_com")
}

model Payment {
  id              String   @id @default(uuid())
  amount          Float
  currency        String
  status          String
  createdAt       DateTime @default(now())
  refunds         Refund[]
  refundedAmount  Float?   @default(0)
  refundDate      DateTime?
}

model Refund {
  id              String   @id @default(uuid())
  paymentId       String
  amount          Float
  refundId        String   @unique // ID PayPal du remboursement
  status          String   // COMPLETED, PENDING, FAILED
  reason          String?
  createdAt       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model AutoType {
  id          Int        @id @default(autoincrement())
  name        String
  alias       String
  powerPS     Int
  body        String
  fuel        String
  yearFrom    Int
  yearTo      Int?
  isDisplayed Boolean    @default(true)
  modeleId    Int
  modele      AutoModele @relation(fields: [modeleId], references: [id])
}

model AutoModele {
  id          Int         @id @default(autoincrement()) 
  name        String
  alias       String
  isDisplayed Boolean     @default(true)
  marqueId    Int
  marque      AutoMarque  @relation(fields: [marqueId], references: [id])
  types       AutoType[]
  model3DUrl  String?     // URL du modèle GLTF
  chatHistory ChatMessage[]
  reviews     Review[]
  videoUrl    String?
  arModelUrl  String?
  specifications ModelSpecification?
}

model AutoMarque {
  id          Int         @id @default(autoincrement())
  name        String
  alias       String 
  isDisplayed Boolean     @default(true)
  modeles     AutoModele[]
  logo        String?
  relfollow   Boolean     @default(true)
  seoData     SeoMarque?
}

model SeoMarque {
  id          Int       @id @default(autoincrement())
  marqueId    Int       
  title       String    
  description String
  keywords    String
  marque      AutoMarque @relation(fields: [marqueId], references: [id])
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  modelId   Int
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id])
  model AutoModele @relation(fields: [modelId], references: [id])

  @@unique([userId, modelId])
  @@index([modelId])
}

model ModelView {
  id       String    @id @default(uuid())
  modelId  Int
  userId   String?
  viewedAt DateTime  @default(now())

  model AutoModele  @relation(fields: [modelId], references: [id])
  user  User?      @relation(fields: [userId], references: [id])

  @@index([modelId])
  @@index([userId])
}

model UserPreferences {
  id             String   @id @default(uuid())
  userId         String   @unique
  favoriteModels Json     @default("[]")
  recentSearches Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  notifications Notification[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  modelId   Int?
  type      String   // "PRICE_DROP", "NEW_MODEL", etc.
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user       UserPreferences @relation(fields: [userId], references: [userId])
  model      AutoModele?     @relation(fields: [modelId], references: [id])

  @@index([userId])
  @@index([modelId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  endpoint  String
  auth      String
  p256dh    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String    @id @default(uuid())
  modelId   Int
  question  String    @db.Text
  answer    String    @db.Text
  createdAt DateTime  @default(now())
  
  model     AutoModele @relation(fields: [modelId], references: [id])

  @@index([modelId])
}

model Review {
  id        String    @id @default(uuid())
  modelId   Int
  userId    String
  rating    Int       // Note sur 5
  comment   String    @db.Text
  createdAt DateTime  @default(now())
  
  model     AutoModele @relation(fields: [modelId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([modelId])
  @@index([userId])
}

model ModelSpecification {
  id          String   @id @default(uuid())
  modelId     Int      @unique
  engine      String
  horsepower  Int
  fuelType    String
  consumption Float
  emissions   Float
  acceleration Float   // 0-100 km/h
  maxSpeed    Int
  weight      Int
  dimensions  Json     // {length, width, height}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  model      AutoModele @relation(fields: [modelId], references: [id])
}

model CarComparison {
  id        String   @id @default(uuid())
  userId    String
  carIds    Json     // Array des IDs de voitures comparées
  results   Json     // Résultats de la comparaison
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PriceAlert {
  id         String   @id @default(uuid())
  userId     String
  modelId    Int
  priceLimit Float
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  user       User       @relation(fields: [userId], references: [id])
  model      AutoModele @relation(fields: [modelId], references: [id])

  @@index([userId])
  @@index([modelId])
}

model UserHistory {
  id        String   @id @default(uuid())
  userId    String
  modelId   Int
  action    String   // "viewed" | "purchased" | "compared"
  metadata  Json?    // Données additionnelles sur l'action
  createdAt DateTime @default(now())
  
  user      User       @relation(fields: [userId], references: [id])
  model     AutoModele @relation(fields: [modelId], references: [id])

  @@index([userId])
  @@index([modelId])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  alias       String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  gammes      Gamme[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gamme {
  id          Int      @id @default(autoincrement())
  name        String
  alias       String   @unique
  description String?  @db.Text
  image       String
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  Int
  models      AutoModele[]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

model AutoMarque {
  id        Int          @id @default(autoincrement())
  name      String       @map("MARQUE_NAME") 
  alias     String       @map("MARQUE_ALIAS")
  logo      String?      @map("MARQUE_LOGO")
  display   Boolean      @default(true) @map("MARQUE_DISPLAY")
  sort      Int          @default(0) @map("MARQUE_SORT")
  top       Boolean      @default(false) @map("MARQUE_TOP")
  models    AutoModel[]

  @@map("AUTO_MARQUE")
}

model AutoModel {
  id        Int        @id @default(autoincrement()) 
  name      String     @map("MODELE_NAME")
  alias     String     @map("MODELE_ALIAS")
  marqueId  Int        @map("MODELE_MARQUE_ID")
  display   Boolean    @default(true) @map("MODELE_DISPLAY")
  sort      Int        @default(0) @map("MODELE_SORT")
  marque    AutoMarque @relation(fields: [marqueId], references: [id])
  types     AutoType[]

  @@map("AUTO_MODELE")
}

model AutoType {
  id         Int       @id @default(autoincrement())
  name       String    @map("TYPE_NAME") 
  alias      String    @map("TYPE_ALIAS")
  power      Int       @map("TYPE_POWER_PS")
  modelId    Int       @map("TYPE_MODELE_ID")
  display    Boolean   @default(true) @map("TYPE_DISPLAY")
  model      AutoModel @relation(fields: [modelId], references: [id])

  @@map("AUTO_TYPE")
}
