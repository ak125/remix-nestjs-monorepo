generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://MASSDOC_owner:npg_cLzOm46MjDEX@ep-young-haze-a2gss4oh-pooler.eu-central-1.aws.neon.tech/MASSDOC?sslmode=require"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
}

model Session {
  id           String  @id @default(cuid())
  userId       String
  ipAddress    String?
  userAgent    String?
  sessionToken String  @unique
  user         User    @relation(fields: [userId], references: [id])
}

model Menu {
  id    Int    @id @default(autoincrement())
  label String
  href  String
  icon  String
  type  String // "account" ou "footer"
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  subject    String
  content    String
  createdAt  DateTime @default(now())

  sender   User @relation(fields: [senderId], references: [id])
  receiver User @relation(fields: [receiverId], references: [id])
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  resetToken String?  @unique
  resetTokenExpiry DateTime?
  createdAt  DateTime @default(now())
}

model Invoice {
  id           String  @id @default(uuid())
  orderId      String  @map("id_com")   // Identifiant de commande
  invoiceNumber String  @map("id_fact") // Numéro de facture
  dateIssued   DateTime @map("date_pay")
  totalAmount  Float   @map("montant_tt")
  shippingFees Float   @map("frais_port")
  clientId     String  @map("id_clt")
  clientName   String  @map("nom_f")
  clientEmail  String  @map("mail_f")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  Order Order @relation(fields: [orderId], references: [id])  // Relation avec une commande
}

model Invoice {
  id          String  @id @default(uuid())
  orderId     String  @unique
  totalAmount Float
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])
  customerId  String
  order       Order @relation(fields: [orderId], references: [id])
}

model Order {
  id       String  @id @default(uuid())
  items    Item[]
  invoice  Invoice?
}

model Item {
  id          String @id @default(uuid())
  productName String
  quantity    Int
  price       Float
  order       Order @relation(fields: [orderId], references: [id])
  orderId     String
}

model Customer {
  id      String @id @default(uuid())
  name    String
  email   String
  address String
  invoices Invoice[]
}


model InvoiceLine {
  id          String   @id @default(uuid())
  invoiceId   String
  nom_gamme   String
  nom_equip   String
  prix_UTTC   Float
  quantite    Int
  prix_TTTC   Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model OrderArchive {
  id          Int      @id @default(autoincrement())
  customerId  Int
  totalAmount Decimal
  status      String
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])
}

model WebSocketConnection {
  id        Int     @id @default(autoincrement())
  userId    Int
  socketId  String  @unique
  createdAt DateTime @default(now())
}
model OrderEquivalence {
  id         Int     @id @default(autoincrement())
  orderId    Int
  oldOrderLineId Int
  newOrderLineId Int
  status     String  @default("pending")
  createdAt  DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id])
}
model Cart {
  id           String   @id @default(uuid())
  userId       String
  items        Json
  totalAmount  Float
  totalConsigne Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


